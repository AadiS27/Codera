ENV=development
PORT=8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s
COMPILE_TIMEOUT=5s
RUN_TIMEOUT=2s
MAX_STDOUT_BYTES=65536
MAX_STDERR_BYTES=65536
SANDBOX_RUNTIME=docker
JAVA_SANDBOX_IMAGE=code-executor-java:latest
EXECUTION_MEMORY=256m
EXECUTION_CPUS=1.0
EXECUTION_PIDS_LIMIT=64
EXECUTION_WORKERS=4
QUEUE_CAPACITY=100

DATABASE_URL=postgres://codera:codera_password@localhost:5432/codera_db?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
RECONCILIATION_INTERVAL=5s
RECONCILIATION_BATCH_SIZE=100

ROLE=all
INSTANCE_ID=

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM=execution-jobs
REDIS_CONSUMER_GROUP=execution-workers
REDIS_PENDING_IDLE_TIMEOUT=30s
REDIS_PENDING_CLAIM_BATCH_SIZE=100
REDIS_STREAM_MAXLEN=10000
